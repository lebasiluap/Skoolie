{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "lib": ["DOM", "ESNext"],
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["../../*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
